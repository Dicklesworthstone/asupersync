#!/usr/bin/env bash
# Opt-in pre-push compile gate for asupersync (br-asupersync-server-stack-hardening,
# br-asupersync-bi2462.87).
#
# WHY: main takes direct pushes (no PR gating) and GitHub Actions is disabled for this
# repo (AGENTS.md "Validation Path"), so never-compiled code reaches main and breaks
# every `cargo build` / `cargo test --lib` fleet-wide before anything flags it. Three
# such fleet-blocking reds landed in a single day from agents that lacked compile
# access. This hook verifies the commit being pushed BEFORE the push completes.
#
# WHAT IT CHECKS: the exact commit being pushed, not this clone's working tree. For each
# distinct tip pushed to main or master it runs, through RCH on that commit
# (`--base <sha> --clean-overlay --no-overlay`, so uncommitted edits in a shared
# checkout are neither verified nor able to fail the push):
#   1. cargo check --all-targets --keep-going (default features);
#   2. when the pushed range touches feature-gated modules, the main watchdog's
#      `check-features` lane for exactly those features (scripts/main_watchdog.py plan).
# RCH is required: there is no local cargo fallback. Clippy and tests are not run (too
# slow to block every push); the main watchdog covers them after landing.
#
# ENABLE (per clone, opt-in — git cannot auto-share hooks):
#     git config core.hooksPath .githooks
# BYPASS a single push you have verified another way (or a docs-only change):
#     git push --no-verify
# DRY RUN (print the RCH commands instead of running them):
#     PREPUSH_DRY_RUN=1 git push ...
# TUNING: PREPUSH_JOBS (cargo -j, default 4), PREPUSH_RCH_ATTEMPTS (admission retries,
# 60 s apart, default 5).
set -euo pipefail

zero=0000000000000000000000000000000000000000
tips=()
bases=()
while read -r _local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
        refs/heads/main|refs/heads/master) ;;
        *) continue ;;
    esac
    [ "$local_sha" = "$zero" ] && continue # deleting a ref builds nothing
    seen=0
    for tip in "${tips[@]+"${tips[@]}"}"; do
        [ "$tip" = "$local_sha" ] && seen=1
    done
    if [ "$seen" -eq 0 ]; then
        tips+=("$local_sha")
        bases+=("$remote_sha")
    fi
done
[ "${#tips[@]}" -gt 0 ] || exit 0

if [ -z "${PREPUSH_DRY_RUN:-}" ] && ! command -v rch >/dev/null 2>&1; then
    echo "[pre-push] REFUSED: rch is not available, so this push could not be verified." >&2
    echo "           RCH is the required validation path (AGENTS.md); there is no local" >&2
    echo "           cargo fallback. Get rch access, or land under Validation Path rule 3." >&2
    exit 1
fi

target="${RCH_TARGET_BASE:-${TMPDIR:-/tmp}}/rch_target_prepush_gate"
run_rch() { # $1 = commit, rest = command
    local sha=$1
    shift
    if [ -n "${PREPUSH_DRY_RUN:-}" ]; then
        echo "[pre-push] dry run, on ${sha:0:12}: $*" >&2
        return 0
    fi
    local attempt rc=0
    for attempt in $(seq 1 "${PREPUSH_RCH_ATTEMPTS:-5}"); do
        CARGO_TARGET_DIR="$target" RCH_REQUIRE_REMOTE=1 \
            rch exec --base "$sha" --clean-overlay --no-overlay -- "$@" && return 0 || rc=$?
        # 103 = RCH admission refused (no worker free): retry; anything else is a result.
        [ "$rc" -eq 103 ] || return "$rc"
        echo "[pre-push] RCH admission refused (attempt $attempt); retrying in 60 s..." >&2
        sleep 60
    done
    return "$rc"
}

# The watchdog's check-features argv for since..tip, one word per line (empty when the
# range touches no feature-gated module or the planner is unavailable at that commit).
feature_lane() {
    local since=$1 tip=$2 script
    if [ "$since" = "$zero" ] || ! git cat-file -e "${since}^{commit}" 2>/dev/null; then
        since=$(git merge-base "$tip" origin/main 2>/dev/null || true)
    fi
    [ -n "$since" ] || return 0
    script="${TMPDIR:-/tmp}/asupersync_prepush_watchdog.py"
    git show "${tip}:scripts/main_watchdog.py" >"$script" 2>/dev/null || return 0
    python3 "$script" plan --since "$since" --until "$tip" --no-fetch --max-batch 100000 \
        --state-dir "${TMPDIR:-/tmp}/asupersync_prepush_watchdog_state" 2>/dev/null |
        python3 -c 'import json, sys
for lane in json.load(sys.stdin).get("lanes", []):
    if lane["id"] == "check-features":
        print("\n".join(lane["argv"]))' 2>/dev/null || true
}

failed=0
for i in "${!tips[@]}"; do
    tip=${tips[$i]}
    echo "[pre-push] ${tip:0:12}: cargo check --all-targets --keep-going (default features)..." >&2
    # Without -j, RCH sizes the job at 16 cores, and no worker admits that (RCH-I003).
    if ! run_rch "$tip" cargo check -j "${PREPUSH_JOBS:-4}" --all-targets --keep-going; then
        echo "[pre-push] REFUSED: 'cargo check --all-targets' FAILED on ${tip:0:12} (or RCH" >&2
        echo "           refused admission; retry later). Fix the errors above, or --no-verify" >&2
        echo "           after verifying another way." >&2
        failed=1
        continue
    fi
    mapfile -t lane < <(feature_lane "${bases[$i]}" "$tip")
    if [ "${#lane[@]}" -gt 0 ]; then
        echo "[pre-push] ${tip:0:12}: ${lane[*]} (feature-gated modules changed)..." >&2
        if ! run_rch "$tip" "${lane[@]}"; then
            echo "[pre-push] REFUSED: the feature-gated check FAILED on ${tip:0:12}." >&2
            failed=1
        fi
    fi
done
[ "$failed" -eq 0 ] || exit 1
echo "[pre-push] compile gate PASSED." >&2
