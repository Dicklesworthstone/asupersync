---
source: src/cli/completion.rs
expression: snapshot
---
{
  "elvish": "# Elvish completion for asupersync\n\nedit:completion:arg-completer[asupersync] = {|@args|\n    var commands = [\n        &serve=(edit:complex-candidate serve &display='serve - Run the network runtime')\n        &trace=(edit:complex-candidate trace &display='trace - Inspect traces in <ABS_TRACE_DIR>')\n        &doctor=(edit:complex-candidate doctor &display='doctor - Check runtime health')\n        &completion=(edit:complex-candidate completion &display='completion - Generate shell completions')\n    ]\n\n    var options = [\n        --config\n        --profile\n        --log-dir\n    ]\n\n    if (eq (count $args) 1) {\n        keys $commands\n    } else {\n        var subcommand = ''\n        for arg $args[..-1] {\n            if (eq $arg serve) {\n                set subcommand = serve\n                break\n            } elif (eq $arg trace) {\n                set subcommand = trace\n                break\n            } elif (eq $arg doctor) {\n                set subcommand = doctor\n                break\n            } elif (eq $arg completion) {\n                set subcommand = completion\n                break\n            }\n        }\n        if (eq $subcommand '') {\n            keys $commands\n        }\n        all $options\n        if (eq $subcommand serve) {\n            put --listen\n            put --tls-cert\n        } elif (eq $subcommand trace) {\n            put --input\n            put --format\n        } elif (eq $subcommand doctor) {\n            put --json\n            put --socket\n        } elif (eq $subcommand completion) {\n            put --shell\n            put --output\n        }\n    }\n}\n",
  "powershell": "# PowerShell completion for asupersync\n\nRegister-ArgumentCompleter -Native -CommandName asupersync -ScriptBlock {\n    param($wordToComplete, $commandAst, $cursorPosition)\n\n    $commands = @(\n        [CompletionResult]::new('serve', 'serve', 'ParameterValue', 'Run the network runtime')\n        [CompletionResult]::new('trace', 'trace', 'ParameterValue', 'Inspect traces in <ABS_TRACE_DIR>')\n        [CompletionResult]::new('doctor', 'doctor', 'ParameterValue', 'Check runtime health')\n        [CompletionResult]::new('completion', 'completion', 'ParameterValue', 'Generate shell completions')\n    )\n\n    $options = @(\n        [CompletionResult]::new('--config', '--config', 'ParameterName', 'Read <ABS_CONFIG_PATH>')\n        [CompletionResult]::new('--profile', '--profile', 'ParameterName', 'Select dev, staging, or prod')\n        [CompletionResult]::new('--log-dir', '--log-dir', 'ParameterName', 'Write logs under <ABS_LOG_DIR>')\n    )\n\n    $subcommandNames = @('serve', 'trace', 'doctor', 'completion')\n    $subcommand = $null\n    $scanCount = if ($wordToComplete.Length -gt 0) { $commandAst.CommandElements.Count - 1 } else { $commandAst.CommandElements.Count }\n    for ($i = 1; $i -lt $scanCount; $i++) {\n        $value = [string]$commandAst.CommandElements[$i].Value\n        if ($subcommandNames -contains $value) {\n            $subcommand = $value\n            break\n        }\n    }\n    $subcommandOptions = @()\n    switch ($subcommand) {\n        'serve' {\n            $subcommandOptions = @(\n                [CompletionResult]::new('--listen', '--listen', 'ParameterName', 'Bind 127.0.0.1:7447')\n                [CompletionResult]::new('--tls-cert', '--tls-cert', 'ParameterName', 'Use <ABS_TLS_CERT>')\n            )\n        }\n        'trace' {\n            $subcommandOptions = @(\n                [CompletionResult]::new('--input', '--input', 'ParameterName', 'Open <ABS_TRACE_FILE>')\n                [CompletionResult]::new('--format', '--format', 'ParameterName', 'Render json or markdown')\n            )\n        }\n        'doctor' {\n            $subcommandOptions = @(\n                [CompletionResult]::new('--json', '--json', 'ParameterName', 'Emit machine-readable output')\n                [CompletionResult]::new('--socket', '--socket', 'ParameterName', 'Probe <ABS_DOCTOR_SOCKET>')\n            )\n        }\n        'completion' {\n            $subcommandOptions = @(\n                [CompletionResult]::new('--shell', '--shell', 'ParameterName', 'Target bash, zsh, or fish')\n                [CompletionResult]::new('--output', '--output', 'ParameterName', 'Write <ABS_OUTPUT_FILE>')\n            )\n        }\n    }\n\n    $commands + $options + $subcommandOptions | Where-Object { $_.CompletionText -like \"$wordToComplete*\" }\n}\n"
}
