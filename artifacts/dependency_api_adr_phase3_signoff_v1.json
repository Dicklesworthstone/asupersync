  "policy": {
    "purpose": "Terminal Phase-3 decision gate. Reconciles all twelve owner ADRs against the live capability registry, feature graph, platform matrix, downstream consumers and documented user journeys, and emits a deterministic decision matrix plus a negative-fixture review.",
    "no_loss_rule": "No resolved ADR may authorize removal or narrowing of any accepted API, feature, format, protocol, platform cell, diagnostic, third-party integration or user journey. KEEP_UNTIL_PARITY is a valid terminal decision.",
    "authority_rule": "Every capability has exactly one primary cutover authority. Secondary compatibility consumers are declared explicitly and are disjoint from the primary set.",
    "evidence_rule": "Naming an evidence owner or scenario id asserts ownership, never that the evidence has run. Every ADR carries evidence state, owners, scenario ids and required evidence classes; each must reconcile with the capability registry.",
    "no_implementation_rule": "This gate authorizes no source change and no dependency cutover. It proves only that downstream campaigns have unambiguous, no-loss contracts to start from.",
    "gap_rule": "Every known gap is owned by a live tracker bead and is marked non-wideable. A gap records a limit of the current implementation; it never licenses narrowing the frozen surface.",
    "truthful_baseline_rule": "Where an ADR found the plan or its own bead factually wrong, the correction is recorded in the ADR's supersedes list rather than silently carried forward.",
    "aggregate_rule": "This artifact is derived. Every row is re-derived from the live registries by the contract test; a stale row is a test failure, not documentation drift."
  },
  "expected_adr_count": 12,
  "expected_capability_count": 17,
  "expected_fixture_count": 20,
  "allowed_terminal_decisions": [
    "KEEP_UNTIL_PARITY",
    "ADDITIVE_COEXISTENCE"
  ],
  "allowed_preserve_cutover_states": [
