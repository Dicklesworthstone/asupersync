      "id": "SQLITE-PARITY-P2-MEMORY-CONFIG-001",
      "family": "in_memory_open_configuration_blocking_bridge",
      "description": "Open a private in-memory database through each async adapter, apply and read back common PRAGMA configuration, execute a typed probe, and close explicitly.",
      "scenario": {
        "kind": "in_memory_configuration",
        "busy_timeout_ms": 37
      },
      "expected": {
        "status": "ok",
        "error_class": null,
        "open_state": "private_memory_opened",
        "configuration_state": "foreign_keys_on_busy_timeout_37",
