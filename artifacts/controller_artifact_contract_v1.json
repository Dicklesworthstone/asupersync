        "required_snapshot_fields": [
          "ready_queue_len",
          "cancel_lane_len",
          "workers_parked"
        ],
        "target_seams": [
          "AA01-SEAM-SCHED-GOVERNOR"
        ],
        "assumptions": [
          "governor telemetry is sampled once per epoch",
          "fallback remains conservative and fail-closed"
        ],
        "bounds": {
          "max_decisions_per_epoch": 32,
          "max_decision_latency_us": 250
        },
        "fallback": {
          "fallback_policy_id": "sched-governor-conservative",
          "rollback_pointer": "artifacts/runtime_control_seam_inventory_v1.json#AA01-SEAM-SCHED-GOVERNOR",
          "activation_conditions": [
            "verifier rejection",
            "calibration regression"
          ]
        },
        "payload": {
          "policy_table_ref": "policies/scheduler_governor_v1.json",
          "compatibility_notes": [
            "requires runtime snapshot schema 1.x"
          ]
        },
        "integrity": {
          "payload_hash": "sha256:ctrl-scheduler-governor-v1",
          "hash_chain": {
            "valid": true,
            "head": "sha256:hash-chain-head"
          },
          "signature_chain": {
            "valid": true,
            "signatures": [
              "ed25519:signature-1"
            ]
          }
        }
      }
    },
