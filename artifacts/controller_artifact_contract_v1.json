      "case_id": "AA02-CASE-HAPPY-PATH",
      "intent": "Accept a well-formed controller artifact manifest",
      "expect_verdict": "accept",
      "expect_rejection_code": "none",
      "manifest": {
        "artifact_id": "ctrl-scheduler-governor-v1",
        "manifest_schema_version": "controller-artifact-manifest-v1",
        "controller_name": "scheduler-governor",
        "controller_version": "1.0.0",
        "snapshot_version_range": {
          "min": {
            "major": 1,
            "minor": 0
          },
          "max": {
            "major": 1,
            "minor": 2
          }
