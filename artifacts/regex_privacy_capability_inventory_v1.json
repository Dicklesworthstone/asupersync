    "pattern_language": "regex 1.13.1 string Regex syntax with default Unicode and performance features",
    "haystack_type": "&str",
    "search": "unanchored is_match unless the pattern supplies anchors",
    "successful_match_output": "[REDACTED]",
    "non_match_output": "original value",
    "partial_replacement": false,
    "capture_replacement": false,
    "pattern_order_visible": false,
    "first_match_short_circuits": true,
    "empty_pattern": "accepted; every value is fully redacted",
    "zero_width_pattern": "accepted; any value with a matching position is fully redacted",
    "lookaround": "rejected",
    "backreferences": "rejected",
    "unicode_default": true,
    "unicode_case_folding": "simple case folding",
    "leftmost_first": "incumbent engine policy, but PrivacyConfig exposes only a boolean match",
    "cache": {
      "builder_added_patterns": "compiled once and stored per config",
      "unchanged_cache": "reused",
      "direct_mutation_stale_cache": "all public strings recompiled on every redact_pii call; cache is not refreshed",
      "clone": "clones both strings and compiled regex handles",
      "thread_sharing": "PrivacyConfig is Send + Sync once constructed"
    }
  },
